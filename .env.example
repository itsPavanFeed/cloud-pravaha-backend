# Generate each secret with the command shown. Never commit the filled-in .env.
POSTGRES_PASSWORD=          # openssl rand -hex 24
CENTRAL_MASTER_KEY=         # openssl rand -base64 32   (central: seals its assertion signing key)
TENANT_MASTER_KEY=          # openssl rand -base64 32   (tenant: seals saved plans and its OIDC key)
PRAVAHA_STATE_KEY=          # openssl rand -hex 32      (runners derive per-stack state encryption keys)
PRAVAHA_PUBLIC_URL=https://localhost:8443
PRAVAHA_TENANT=main         # slug of the tenant this install's tenant plane serves
PRAVAHA_RUNNER_TOKEN=       # from Tenant settings -> Register runner
PRAVAHA_ASSISTANT_API_KEY=  # optional: Anthropic API key; enables the assistant (sends questions and retrieved passages to the API)

# Optional: GitHub App webhooks. Public address GitHub posts to (central), e.g. an ngrok tunnel.
PRAVAHA_WEBHOOK_BASE_URL=
# Optional: GitHub App settings. Saved here by the console when the tenant plane runs with PRAVAHA_ENV_FILE.
PRAVAHA_GITHUB_APP_ID=
PRAVAHA_GITHUB_APP_PRIVATE_KEY_FILE=   # path to the app's .pem (relative to this file)
PRAVAHA_GITHUB_WEBHOOK_SECRET=         # openssl rand -hex 32; the same value in the app's webhook settings
# Optional: Slack incoming webhook for notifications (Integrations → Slack writes it here with PRAVAHA_ENV_FILE).
PRAVAHA_SLACK_WEBHOOK_URL=
# Runner: runs executed at the same time by one runner (each in its own folders).
PRAVAHA_RUNNER_CONCURRENCY=2
